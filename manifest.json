{
  "manifest_version": 3,
  "name": "Job Listing Highlighter",
  "version": "1.0",
  "description": "Highlights job listings based on their destination URLs",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/favicon-16x16.png",
      "32": "icons/favicon-32x32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*", "https://www.linkedin.com/*", "https://*.greenhouse.io/*", "https://*.lever.co/*", "https://*.myworkdayjobs.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "icons": {
    "16": "icons/favicon-16x16.png",
    "32": "icons/favicon-32x32.png",
    "48": "icons/apple-touch-icon.png",
    "128": "icons/android-chrome-192x192.png"
  }
}